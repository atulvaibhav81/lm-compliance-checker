# ─── Application ───────────────────────────────────────
APP_NAME=LM Compliance Checker
APP_ENV=development
DEBUG=true

# ─── Database (SQLite for local dev) ──────────────────
DATABASE_URL=sqlite:///./lm_compliance.db

# ─── File Upload ──────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Tesseract OCR ────────────────────────────────────
# Windows default path after installer:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ─── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
